# =============================================================================
# PrepAI environment template
# Copy to .env (repo root) or server/.env. Never commit real secrets.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://prepai.yourdomain.com,http://localhost:5180

# ---- Database ---------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/prepai?retryWrites=true&w=majority
# Pool sizing is per Node process. 4 instances x 75 = 300 connections.
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_POOL_SIZE=25
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=60000
# Enable only when an actual replica set / Atlas cluster is in use.
MONGO_SECONDARY_READS=true

# ---- Auth -------------------------------------------------------------------
# Production requires >= 32 chars; the server refuses to boot otherwise.
JWT_SECRET=prepai_super_secret_jwt_key_2026_production_ready
JWT_EXPIRES_IN=7d

# ---- Version stamps (bump with prompt/rubric changes) ---------------------
PROMPT_VERSION=2026.02.1
RUBRIC_VERSION=2026.02.1

# ---- LLM --------------------------------------------------------------------
# Leave empty to run the deterministic simulation (no provider calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Per-instance concurrency + bounded queue (fail fast with typed 503s).
LLM_CONCURRENCY_PER_INSTANCE=50
LLM_QUEUE_MAX=200
LLM_QUEUE_TIMEOUT_MS=15000
# Cluster-wide ceiling enforced through Redis.
LLM_GLOBAL_CONCURRENCY=200
LLM_GLOBAL_SLOT_TTL_MS=120000

# Retries / backoff.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=400
LLM_RETRY_MAX_DELAY_MS=8000
LLM_RETRY_JITTER=true
LLM_PROMPT_CACHING=true
LLM_FALLBACK_ENABLED=true

# Call timeouts.
LLM_OPENING_TIMEOUT_MS=3000
LLM_STREAM_IDLE_TIMEOUT_MS=30000

# Token budgets (per user and per session). Reservations are conservative.
LLM_TOKEN_BUDGET_ENABLED=true
LLM_DAILY_TOKENS_PER_USER=120000
LLM_SESSION_TOKENS=30000
LLM_RESERVE_OPENING_TOKENS=700
LLM_RESERVE_TURN_TOKENS=1200
LLM_RESERVE_FINAL_TOKENS=2500

# ---- Redis ------------------------------------------------------------------
# Leave empty to run entirely in-memory (supported, but no shared state).
REDIS_URL=redis://127.0.0.1:6379
REDIS_DISABLED=false
REDIS_KEY_PREFIX=prepai
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_MAX_RETRIES=3

# ---- Server / proxy ---------------------------------------------------------
# Number of trusted proxy hops (ALB / Render / Railway = 1).
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=65000
# Must exceed the LB idle timeout. LB idle >= 120s for SSE.
KEEPALIVE_TIMEOUT_MS=65000
GRACEFUL_SHUTDOWN_MS=15000
SSE_DRAIN_MS=8000

# ---- SSE --------------------------------------------------------------------
SSE_HEARTBEAT_MS=15000
SSE_MAX_PER_USER=2
SSE_MAX_PER_IP=10
SSE_REGISTRY_TTL_SECONDS=3600
SSE_DEDUP_WINDOW_MS=12000
SSE_MAX_BUFFERED_EVENTS=2000
SSE_RECONNECT_HINT_MS=1500

# ---- Rate limits ------------------------------------------------------------
RATE_LIMIT_STANDARD_WINDOW_MS=900000
RATE_LIMIT_STANDARD_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_START_WINDOW_MS=600000
RATE_LIMIT_START_MAX=15
RATE_LIMIT_ANSWER_WINDOW_MS=300000
RATE_LIMIT_ANSWER_MAX=40
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120

# ---- Timeouts (ms) ----------------------------------------------------------
TIMEOUT_STANDARD_API_MS=5000
TIMEOUT_HEAVY_QUERY_MS=10000
TIMEOUT_FILE_UPLOAD_MS=15000
TIMEOUT_AI_INFERENCE_MS=30000
TIMEOUT_EXTERNAL_SERVICE_MS=6000

# ---- Security ---------------------------------------------------------------
MAX_ANSWER_LENGTH=4000
AUDIT_HOT_RETENTION_DAYS=90

# ---- Observability ----------------------------------------------------------
METRICS_ENABLED=true
# Required to scrape /metrics in production.
METRICS_TOKEN=

# ---- Learning loops (offline, human-gated) ----------------------------------
# Enabled by default in production; disabled in dev/test for determinism.
LEARNING_LOOPS_ENABLED=false
ADAPTIVE_SELECTION_ENABLED=false
LEARNING_CALIBRATION_INTERVAL_MS=21600000
LEARNING_AGGREGATE_INTERVAL_MS=3600000
LEARNING_MIN_ATTEMPTS=30
LEARNING_MIN_DISCRIMINATION=0.2
LEARNING_EXPOSURE_CAP_SHARE=0.15
LEARNING_EXPLORATION_EPSILON=0.1
LEARNING_ABILITY_K=24
LEARNING_ANOMALY_Z=2
LEARNING_GOLDEN_MIN_SAMPLES=30
LEARNING_VERSION_CACHE_SECONDS=3600
